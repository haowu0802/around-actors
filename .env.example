# Copy to .env and fill locally. Never commit .env.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/around-actors

# Optional extras for ingest (use your own paths locally):
# EXPORT_FILE=/absolute/path/to/export.json
# ACTOR_KEY=person_a

# Optional extras for voice WAV staging (no ASR):
# VOICE_WAV_DIR=/absolute/path/to/wav_dir
# AUDIO_BUNDLE_KEY=person_a_wav_bundle
# VOICE_SOURCE_SYSTEM=wechat_silk_wav

# Optional extras for Whisper ASR:
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_LANGUAGE=zh

# Optional speaker matchers for stg.messages build (comma-separated substrings):
# ACTOR_SPEAKER_MATCH=person_display_or_username
# SELF_SPEAKER_MATCH=my_display_or_username

# Kobold / OpenAI-compatible LLM (this machine = client; GPU box can be remote):
# Local:  KOBOLD_URL=http://127.0.0.1:5001/v1
# LAN:    KOBOLD_URL=http://192.168.x.x:5001/v1
# Trailing slash optional; scripts normalize to .../v1
# KOBOLD_URL=http://127.0.0.1:5001/v1
# KOBOLD_MODEL=
# On the GPU host, use koboldcpp with host 0.0.0.0 (see qwen25_14b_ab_lan.kcpps)
# and allow inbound TCP 5001 on that host firewall.

# ACTOR_DISPLAY_NAME=PersonA
# PERSONA_CARD=/absolute/path/to/persona.json
# Default card path if unset: data/private/personas/<ACTOR_KEY>.json

# Fact topics (official, after topics apply):
# data/private/fact_topics/<ACTOR_KEY>.json
#
# Topics pending (gitignored):
# data/private/topics_pending/<ACTOR_KEY>.json
# Workflow:
#   python scripts/build_persona_topics.py --actor-key person_a --mode extract --limit 15
#   python scripts/build_persona_topics.py --actor-key person_a --mode set-status --keys draft_xxx --status approved
#   python scripts/build_persona_topics.py --actor-key person_a --mode apply
# Optional stopwords: data/private/topic_mine/stopwords.json
#
# Facts pending (gitignored):
# data/private/facts_pending/<ACTOR_KEY>.json
# Workflow:
#   python scripts/build_persona_facts.py --actor-key person_a --mode extract --limit 10
#   python scripts/build_persona_facts.py --actor-key person_a --mode set-status --keys a,b --status approved
#   python scripts/build_persona_facts.py --actor-key person_a --mode apply --ensure-schema
# Optional: --since-days 365  --min-score 40  --include-active-keys
#
# Local review UI (Topics + Facts tabs):
#   pip install streamlit
#   streamlit run scripts/fact_review_app.py

# Chat locale (prompt templates / stop tokens); Chinese stays out of .py:
# CHAT_LOCALE=/absolute/path/to/locale.json
# Default: data/private/locales/zh_wechat.json

# LoRA pairs from build_lora_pairs.py write to:
# data/private/lora/<ACTOR_KEY>/{train,holdout}.jsonl
